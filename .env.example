# Copy this file to .env and fill in your values.

# Required: OpenAI API key used for embeddings.
OPENAI_API_KEY=sk-...

# Qdrant connection (defaults assume the docker-compose service below).
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Embeddings
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Chunking
CHUNK_MAX_TOKENS=500
CHUNK_OVERLAP_TOKENS=50

# Optional: default collection for the MCP server if you don't pass --collection.
LOCALRAG_COLLECTION=
